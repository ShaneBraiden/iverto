{
  "name": "iverto-load-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Load / stress test suite for the Iverto Outpass backend (k6).",
  "scripts": {
    "pool": "node scripts/login-pool-v2.mjs",
    "verify": "node scripts/verify-accounts-v2.mjs",
    "smoke": "k6 run --out csv=results/smoke-v2.csv --summary-export results/smoke-v2.json k6/v2/smoke.js",
    "load": "k6 run --out csv=results/load-v2.csv --summary-export results/load-v2.json k6/v2/load.js",
    "stress": "k6 run --out csv=results/stress-v2.csv --summary-export results/stress-v2.json k6/v2/stress.js",
    "sockets": "k6 run --summary-export results/socket-v2.json k6/v2/socket.js",
    "analyze": "node scripts/analyze-csv.mjs",
    "v1:verify": "node scripts/verify-accounts.mjs",
    "v1:cleanup": "node scripts/cleanup.mjs",
    "v1:smoke": "k6 run k6/smoke.js",
    "v1:load": "k6 run --summary-export results/load-summary.json k6/load.js",
    "v1:stress": "k6 run --summary-export results/stress-summary.json --out json=results/stress-raw.json k6/stress.js",
    "v1:spike": "k6 run --summary-export results/spike-summary.json k6/spike.js",
    "v1:soak": "k6 run --summary-export results/soak-summary.json --out json=results/soak-raw.json k6/soak.js",
    "v1:sockets": "k6 run --summary-export results/socket-summary.json k6/socket.js",
    "v1:login-storm": "k6 run --summary-export results/login-storm-summary.json k6/login-storm.js"
  },
  "engines": { "node": ">=18" }
}
