# Copy to .env and `source` it, or pass each as `-e KEY=VALUE` to `k6 run`.
# k6 does NOT read .env automatically — see RUNBOOK.md §3.
#
# Defaults below match the app's current API_URL (app.json extra.apiUrl /
# .env EXPO_PUBLIC_API_URL = https://api.iverto.ai/devhostel). The v2 scripts
# (k6/v2/*, scripts/*-v2.mjs) already default to these values.

# --- Target -------------------------------------------------------------------
# Origin only, no path.
BASE_URL=https://api.iverto.ai
# Deployment prefix Caddy routes on: /devhostel (current app target), /hostel (prod).
API_PREFIX=/devhostel
WS_PREFIX=/devhostel
# Tenant code for POST /v2/auth/password/login.
TENANT_CODE=acme

# --- Account pool -----------------------------------------------------------
# data/accounts.json — built from Test/*.csv. Login identifier on v2 is the email.
# scripts/login-pool-v2.mjs logs a sample in (≤10 logins/min/IP) -> data/tokens.json.
# POOL=student:24,parent:8,warden:3,admin:2
# PACE_MS=6500

# --- Traffic shape --------------------------------------------------------
# ROLE_MIX=student:80,parent:15,warden:4,admin:1
# RATE=30          (k6/v2/load.js journeys/s)
# DURATION=5m
# PEAK=150         (k6/v2/stress.js journeys/s, k6/v2/socket.js connections)

# --- v1 suite only (k6/*.js — /v1/mobile, not deployed on /devhostel) --------
WRITE_MODE=off
LOCATION_PINGS=off
KEEP_WRITES=false
