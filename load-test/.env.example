# Copy to .env and `source` it, or pass each as `-e KEY=VALUE` to `k6 run`.
# k6 does NOT read .env automatically — see RUNBOOK.md §3.

# --- Target -------------------------------------------------------------------
# Origin only, no path.
BASE_URL=https://api.iverto.ai
# Deployment prefix Caddy routes on: /hostel (prod), /devhostel (dev), empty (local).
API_PREFIX=/hostel
WS_PREFIX=/hostel

# --- Account pool -----------------------------------------------------------
# Absolute path recommended. If relative, it is resolved against k6/lib/.
ACCOUNTS_FILE=./data/accounts.json

# --- Write safety ----------------------------------------------------------
# off | light | full   (default off — GET + auth only, safe for production)
WRITE_MODE=off
# on -> student journeys also POST /location/ping
LOCATION_PINGS=off
# true -> keep submitted test passes instead of cancelling them (needs cleanup)
KEEP_WRITES=false
# Stamped into every created record so scripts/cleanup.mjs can find them.
# RUN_TAG=loadtest-2026-09-07T21-00

# --- Traffic shape --------------------------------------------------------
# ROLE_MIX=student:80,parent:15,warden:4,admin:1
