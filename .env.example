# Base URL of the Iverto Outpass API. No trailing slash.
#
# Every path in lib/api/endpoints.ts is written from the version segment on
# (`/v1/mobile/...`) and appended to this:
#
#   https://api.iverto.ai/hostel  +  /v1/mobile/permissions
#
# The `/hostel` segment is a deployment setting, not a code default: the host
# runs two services and Caddy routes `/hostel` to this one with the prefix
# intact. It belongs in this URL and nowhere else in the app — the socket
# handshake path is derived from it (lib/live.ts).
#
# Leave this unset and the app falls back to `extra.apiUrl` in app.json, which
# points at production — so a release build works with no env at all.
EXPO_PUBLIC_API_URL=https://api.iverto.ai/hostel

# Local development. A backend run without API_PREFIX / WS_PATH set serves
# plain `/v1/...` and `/socket.io`, so there is no `/hostel` to add here.
# `localhost` is the phone itself, so use the host's LAN address from a real
# device.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
