{
  "expo": {
    "name": "Iverto.ai",
    "slug": "iverto-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "iverto",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F3F3"
    },
    "assetBundlePatterns": ["assets/*.png"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iverto.ai",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.iverto.ai",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F3F3"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "iverto" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Iverto.ai shares your position with the guardians on your record so they can see whether you are on campus. It is off until you turn it on, and only while the app is open.",
          "locationWhenInUsePermission": "Iverto.ai shares your position with the guardians on your record so they can see whether you are on campus. It is off until you turn it on.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B9000E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://api.iverto.ai/hostel"
    }
  }
}
